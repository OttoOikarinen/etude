{
    "id" : "fi.oikarinenotto.etude",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "etude",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "python3-fsrs",
            "buildsystem" : "simple",
            "build-commands" : [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} fsrs --no-build-isolation"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url" : "https://files.pythonhosted.org/packages/49/d3/b8441a820a491ddfc024b0b0cf0393375b75ea13866d9c66727e54c2fc80/typing_extensions-4.16.0-py3-none-any.whl",
                    "sha256" : "481caa481374e813c1b176ada14e97f1f67a4539ce9cfeb3f350d78d6370c2e8"
                },
                {
                    "type" : "file",
                    "url" : "https://files.pythonhosted.org/packages/00/b9/c815e796480dd22441886f06b23f249a7ff2e3f41fc9bfaa428332e34b49/fsrs-6.3.2-py3-none-any.whl",
                    "sha256" : "bc55066c821164b1cff6d75b17a3ed8e86cfd45789e3d775cfcb895319ce9ba4"
                }
            ]
        },
        {
            "name" : "fluidsynth",
            "buildsystem" : "cmake-ninja",
            "config-opts" : [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_INSTALL_LIBDIR=lib",
                "-Denable-pulseaudio=ON",
                "-Denable-signalsmith=OFF",
                "-Denable-alsa=OFF",
                "-Denable-dbus=OFF",
                "-Denable-jack=OFF",
                "-Denable-ladspa=OFF",
                "-Denable-libsndfile=OFF",
                "-Denable-network=OFF",
                "-Denable-oss=OFF",
                "-Denable-pipewire=OFF",
                "-Denable-portaudio=OFF",
                "-Denable-readline=OFF",
                "-Denable-sdl3=OFF",
                "-Denable-systemd=OFF"
            ],
            "cleanup" : [
                "/bin"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/FluidSynth/fluidsynth.git",
                    "tag" : "v2.6.1",
                    "commit" : "71e85b2ca6bf48641ba7e2261d8f2640ae473773",
                    "x-checker-data" : {
                        "type" : "git",
                        "tag-pattern" : "^v([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name" : "generaluser-gs",
            "buildsystem" : "simple",
            "build-commands" : [
                "install -Dm644 GeneralUser-GS.sf2 ${FLATPAK_DEST}/share/etude/soundfonts/GeneralUser-GS.sf2",
                "install -Dm644 LICENSE.txt ${FLATPAK_DEST}/share/licenses/${FLATPAK_ID}/GeneralUser-GS.txt"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url" : "https://github.com/mrbumpy409/GeneralUser-GS/raw/684543d5e5efaef08d02be50dcda8d552478fa60/GeneralUser-GS.sf2",
                    "sha256" : "9575028c7a1f589f5770fccc8cff2734566af40cd26ed836944e9a5152688cfe"
                },
                {
                    "type" : "file",
                    "url" : "https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/684543d5e5efaef08d02be50dcda8d552478fa60/documentation/LICENSE.txt",
                    "sha256" : "7b32efefdf95ce38a043799f0659853ddc00fbaa14d8c50f0aca16b9b8b405be",
                    "dest-filename" : "LICENSE.txt"
                }
            ]
        },
        {
            "name" : "etude",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : ".",
                    "skip" : [
                        ".venv",
                        ".flatpak-builder",
                        "_build",
                        "build-dir",
                        "repo"
                    ]
                }
            ]
        }
    ]
}
