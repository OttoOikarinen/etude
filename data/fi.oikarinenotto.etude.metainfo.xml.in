<component type="desktop-application">
  <id>fi.oikarinenotto.etude</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Etude</name>
  <summary>Learn music theory by eye and ear</summary>
  <description>
    <p>
      Etude teaches music theory and aural skills, from reading your first
      notes to the analysis taught in university music programmes. Every
      topic is practised both on the staff and by ear.
    </p>
    <ul>
      <li>Name notes, key signatures, intervals, chords, scale degrees and rhythms</li>
      <li>Train your ear with intervals, chords, cadences, progressions and dictation</li>
      <li>Short theory lessons with playable examples, and a music glossary</li>
      <li>Spaced repetition schedules reviews so that you remember what you learn</li>
      <li>Works fully offline, with no accounts and no tracking</li>
    </ul>
  </description>

  <developer id="fi.oikarinenotto">
    <name translate="no">Otto Oikarinen</name>
  </developer>

  <url type="homepage">https://github.com/OttoOikarinen/etude</url>
  <url type="bugtracker">https://github.com/OttoOikarinen/etude/issues</url>
  <url type="vcs-browser">https://github.com/OttoOikarinen/etude</url>
  <url type="contribute">https://github.com/OttoOikarinen/etude/blob/master/CONTRIBUTING.md</url>

  <translation type="gettext">etude</translation>
  <launchable type="desktop-id">fi.oikarinenotto.etude.desktop</launchable>
  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#78aeed</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-10-15" type="development">
      <description translate="no">
        <p>Development snapshot.</p>
      </description>
    </release>
  </releases>
</component>
