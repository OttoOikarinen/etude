<curriculum>
  <level id="level1" number="1">
    <title>Fundamentals</title>
    <description>Reading notes and rhythms, keys and scales, intervals and triads, and the basic vocabulary of music.</description>

    <unit id="l1.staff" lesson="l1.staff">
      <title>Staff, Clefs and Note Names</title>
      <summary>Read notes in the treble and bass clefs, with ledger lines.</summary>
      <practice exercise="note-naming">
        <setting key="clefs" value="treble bass"/>
        <setting key="ledger-lines" value="1"/>
        <setting key="accidentals" value="false"/>
      </practice>
      <practice exercise="note-placement">
        <setting key="clefs" value="treble bass"/>
        <setting key="ledger-lines" value="1"/>
        <setting key="accidentals" value="false"/>
      </practice>
      <vocabulary tags="staff"/>
    </unit>

    <unit id="l1.rhythm" lesson="l1.rhythm">
      <title>Note Values and Rests</title>
      <summary>Whole, half, quarter, eighth and sixteenth notes, dots and rests.</summary>
      <practice exercise="note-values"/>
      <practice exercise="rhythm-tap">
        <setting key="vocabulary" value="quarters halves eighths rests dotted-quarter"/>
        <setting key="meters" value="2/4 3/4 4/4"/>
      </practice>
      <practice exercise="rhythm-dictation">
        <setting key="vocabulary" value="halves eighths rests"/>
        <setting key="meters" value="2/4 3/4 4/4"/>
      </practice>
      <vocabulary tags="rhythm"/>
    </unit>

    <unit id="l1.meter" lesson="l1.meter">
      <title>Beat and Time Signatures</title>
      <summary>Pulse, bars, simple and compound time.</summary>
      <practice exercise="meter-ear">
        <setting key="compound" value="true"/>
      </practice>
      <practice exercise="rhythm-tap">
        <setting key="vocabulary" value="quarters halves eighths rests dotted-quarter sixteenths"/>
        <setting key="meters" value="2/4 3/4 4/4 6/8"/>
      </practice>
      <vocabulary tags="meter"/>
    </unit>

    <unit id="l1.accidentals" lesson="l1.accidentals">
      <title>Accidentals, Half Steps and Whole Steps</title>
      <summary>Sharps, flats and naturals on the staff and on the keyboard.</summary>
      <practice exercise="note-naming">
        <setting key="clefs" value="treble bass"/>
        <setting key="ledger-lines" value="1"/>
        <setting key="accidentals" value="true"/>
      </practice>
      <practice exercise="note-placement">
        <setting key="clefs" value="treble bass"/>
        <setting key="ledger-lines" value="1"/>
        <setting key="accidentals" value="true"/>
      </practice>
      <vocabulary tags="accidentals"/>
    </unit>

    <unit id="l1.major" lesson="l1.major">
      <title>Major Scales and Keys</title>
      <summary>The major scale, key signatures and the circle of fifths.</summary>
      <practice exercise="keysig">
        <setting key="mode" value="major"/>
        <setting key="max-accidentals" value="7"/>
      </practice>
      <vocabulary tags="scales keys"/>
    </unit>

    <unit id="l1.minor" lesson="l1.minor">
      <title>Minor Scales and Keys</title>
      <summary>Natural, harmonic and melodic minor; relative and parallel keys.</summary>
      <practice exercise="keysig">
        <setting key="mode" value="both"/>
        <setting key="max-accidentals" value="7"/>
      </practice>
      <practice exercise="scale-staff">
        <setting key="modes" value="false"/>
      </practice>
      <practice exercise="scale-ear">
        <setting key="modes" value="false"/>
        <setting key="pentatonic" value="false"/>
      </practice>
      <vocabulary tags="minor"/>
    </unit>

    <unit id="l1.intervals" lesson="l1.intervals">
      <title>Intervals</title>
      <summary>Number and quality of intervals, on the staff and by ear.</summary>
      <practice exercise="interval-staff"/>
      <practice exercise="interval-ear">
        <setting key="form" value="melodic"/>
        <setting key="direction" value="asc"/>
      </practice>
      <practice exercise="interval-construction"/>
      <vocabulary tags="intervals"/>
    </unit>

    <unit id="l1.degrees" lesson="l1.degrees">
      <title>Scale Degrees</title>
      <summary>The names and functions of the degrees of a key.</summary>
      <practice exercise="scale-degree">
        <setting key="mode" value="both"/>
      </practice>
      <practice exercise="degree-ear">
        <setting key="mode" value="both"/>
      </practice>
      <vocabulary tags="degrees"/>
    </unit>

    <unit id="l1.triads" lesson="l1.triads">
      <title>Triads</title>
      <summary>Major, minor, diminished and augmented triads and their inversions.</summary>
      <practice exercise="chord-staff"/>
      <practice exercise="chord-ear"/>
      <vocabulary tags="chords"/>
    </unit>

    <unit id="l1.terms" lesson="l1.terms">
      <title>Tempo, Dynamics and Articulation</title>
      <summary>The Italian terms and signs that tell how to perform music.</summary>
      <practice exercise="symbols"/>
      <vocabulary tags="tempo dynamics articulation directions"/>
    </unit>

    <exam size="30"/>
  </level>
  <level id="level2" number="2">
    <title>Intermediate</title>
    <description>Seventh chords, Roman numeral analysis and harmonic function, cadences, figured bass and four-part writing; nonchord tones, phrases and periods; the church modes, transposition, advanced rhythm and dictation.</description>

    <unit id="l2.sevenths" lesson="l2.sevenths">
      <title>Seventh Chords</title>
      <summary>The five common seventh chords, their inversions and figures.</summary>
      <practice exercise="chord-staff">
        <setting key="sevenths" value="true"/>
      </practice>
      <practice exercise="chord-ear">
        <setting key="sevenths" value="true"/>
      </practice>
      <vocabulary tags="sevenths"/>
    </unit>

    <unit id="l2.roman" lesson="l2.roman">
      <title>Roman Numerals and Harmonic Function</title>
      <summary>Analyze chords in a key; tonic, predominant and dominant.</summary>
      <practice exercise="roman-numerals">
        <setting key="mode" value="both"/>
      </practice>
      <vocabulary tags="function"/>
    </unit>

    <unit id="l2.modes" lesson="l2.modes">
      <title>Church Modes</title>
      <summary>Dorian, Phrygian, Lydian, Mixolydian and Locrian, on the staff and by ear.</summary>
      <practice exercise="scale-staff">
        <setting key="modes" value="true"/>
      </practice>
      <practice exercise="scale-ear">
        <setting key="modes" value="true"/>
      </practice>
      <vocabulary tags="modes"/>
    </unit>

    <unit id="l2.cadences" lesson="l2.cadences">
      <title>Cadences</title>
      <summary>Authentic, half, plagal and deceptive cadences, and the cadential six-four.</summary>
      <practice exercise="cadences-staff">
        <setting key="phrygian" value="true"/>
      </practice>
      <practice exercise="cadence-ear">
        <setting key="mode" value="both"/>
        <setting key="authentic-kinds" value="true"/>
        <setting key="phrygian" value="true"/>
      </practice>
      <vocabulary tags="cadences"/>
    </unit>

    <unit id="l2.rhythm" lesson="l2.rhythm">
      <title>Syncopation, Triplets and Compound Meters</title>
      <summary>Rhythms that go against the beat or divide it in a new way.</summary>
      <practice exercise="rhythm-tap">
        <setting key="vocabulary" value="quarters halves eighths rests dotted-quarter sixteenths syncopation dotted-eighth triplets"/>
        <setting key="meters" value="2/4 3/4 4/4 6/8 9/8 12/8"/>
      </practice>
      <practice exercise="rhythm-dictation">
        <setting key="vocabulary" value="halves eighths rests dotted-quarter syncopation dotted-eighth triplets"/>
        <setting key="meters" value="2/4 3/4 4/4 6/8 9/8 12/8"/>
      </practice>
      <vocabulary tags="rhythm2"/>
    </unit>

    <unit id="l2.figured-bass" lesson="l2.figured-bass">
      <title>Figured Bass</title>
      <summary>Read the figures under a bass line and realize them in four parts.</summary>
      <practice exercise="figured-bass">
        <setting key="slashed" value="true"/>
      </practice>
      <practice exercise="inversion-ear">
        <setting key="sevenths" value="dominant"/>
      </practice>
      <vocabulary tags="figured-bass"/>
    </unit>

    <unit id="l2.transposition" lesson="l2.transposition">
      <title>Transposition</title>
      <summary>Move music to another key and write for transposing instruments.</summary>
      <practice exercise="transposition">
        <setting key="instruments" value="true"/>
        <setting key="instrument-direction" value="both"/>
      </practice>
      <vocabulary tags="transposition"/>
    </unit>

    <unit id="l2.voice-leading" lesson="l2.voice-leading">
      <title>Four-Part Writing</title>
      <summary>Ranges, spacing, doubling, motion between voices and resolving tendency tones.</summary>
      <practice exercise="satb-writing"/>
      <practice exercise="satb-errors"/>
      <vocabulary tags="voice-leading"/>
    </unit>

    <unit id="l2.nonchord" lesson="l2.nonchord">
      <title>Nonchord Tones</title>
      <summary>Passing and neighbor tones, suspensions, appoggiaturas, anticipations and pedal points.</summary>
      <vocabulary tags="nonchord"/>
    </unit>

    <unit id="l2.phrase" lesson="l2.phrase">
      <title>Motive, Phrase and Period</title>
      <summary>How phrases end in cadences and pair up into periods and sentences.</summary>
      <practice exercise="cadence-ear">
        <setting key="mode" value="both"/>
        <setting key="authentic-kinds" value="true"/>
        <setting key="phrygian" value="true"/>
      </practice>
      <vocabulary tags="form"/>
    </unit>

    <unit id="l2.dictation" lesson="l2.dictation">
      <title>Melodic and Harmonic Dictation</title>
      <summary>Strategies for writing down melodies and chord progressions by ear.</summary>
      <practice exercise="melodic-dictation">
        <setting key="max-accidentals" value="3"/>
        <setting key="meters" value="2/4 3/4 4/4"/>
      </practice>
      <practice exercise="progression-ear">
        <setting key="mode" value="both"/>
      </practice>
      <vocabulary tags="dictation"/>
    </unit>

    <exam size="30"/>
  </level>
</curriculum>
