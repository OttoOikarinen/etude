<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: 2026 Otto Oikarinen
SPDX-License-Identifier: CC0-1.0

ITS rules for Etude's content XML: which elements are translated, which
inline elements are part of the surrounding sentence, and notes for
translators. Used by xgettext (via etude.loc) and itstool (i18n.itstool_join).
-->
<its:rules xmlns:its="http://www.w3.org/2005/11/its" version="2.0">
  <!-- Nothing is translated unless a rule below says so. -->
  <its:translateRule selector="/*" translate="no"/>

  <!-- Translatable units. -->
  <its:translateRule translate="yes" selector="
      //curriculum//title | //curriculum//description | //curriculum//summary |
      //lesson//title | //lesson/summary | //lesson//p | //lesson//li |
      //lesson//caption | //lesson//prompt | //lesson//option | //lesson//explanation |
      //lesson//description |
      //glossary/entry/term | //glossary//gloss | //glossary//def | //glossary//caption |
      //glossary//description"/>

  <!-- Inline elements are part of the sentence around them. -->
  <its:withinTextRule withinText="yes" selector="//em | //p/term | //li/term | //def/term |
      //caption/term | //prompt/term | //option/term | //explanation/term | //note"/>

  <!-- Original-language terms (crescendo, Allegro) stay as they are. -->
  <its:translateRule translate="no" selector="//foreign | //abbr | //staff"/>

  <its:locNoteRule locNoteType="description" selector="//glossary/entry/term">
    <its:locNote>A music term as it is written in your language's music textbooks.</its:locNote>
  </its:locNoteRule>
  <its:locNoteRule locNoteType="description" selector="//p | //li | //explanation">
    <its:locNote>Text of a music theory lesson. Keep the &lt;note&gt; elements: the application writes note names in the learner's naming convention (C D E… or H/B or do re mi).</its:locNote>
  </its:locNoteRule>
  <its:locNoteRule locNoteType="description"
      selector="//entry[@id='parallel-key']/term | //entry[@id='parallel-key']/gloss">
    <its:locNote>English "parallel key" = same tonic, different key signature (C major / C minor). In German and Finnish the word for "parallel" (Paralleltonart, rinnakkaissävellaji) means the RELATIVE key; use your language's term for the same-tonic key (e.g. Varianttonart, samanniminen sävellaji).</its:locNote>
  </its:locNoteRule>
  <its:locNoteRule locNoteType="description"
      selector="//entry[@id='relative-key']/term | //entry[@id='relative-key']/gloss">
    <its:locNote>English "relative key" = same key signature, different tonic (C major / A minor). In German this is Paralleltonart, in Finnish rinnakkaissävellaji.</its:locNote>
  </its:locNoteRule>
  <its:locNoteRule locNoteType="description" selector="//entry[@id='middle-c']/term">
    <its:locNote>The usual name for C4 in your language (e.g. "do central", "eingestrichenes c", "yksiviivainen c").</its:locNote>
  </its:locNoteRule>
</its:rules>
